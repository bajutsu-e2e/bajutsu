# Regenerate uv.lock from pyproject.toml on a merge conflict instead of line-merging the
# resolver output (BE-0043). The `uv-lock` driver is wired by `make hooks` / `make setup`
# (scripts/merge-uv-lock.sh); without it git falls back to the default merge, which is harmless.
uv.lock merge=uv-lock

# Regenerate apm.lock.yaml from .apm/skills/ on a merge conflict instead of line-merging `apm
# install` output (BE-0390, mirroring the uv.lock driver above). The `apm-lock` driver is wired by
# `make hooks` / `make setup` (scripts/merge-apm-lock.sh); without it git falls back to the default
# merge, which conflicts on the `generated_at` line for any two branches that touched a skill.
apm.lock.yaml merge=apm-lock
