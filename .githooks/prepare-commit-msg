#!/bin/bash
# prepare-commit-msg hook. Two independent jobs, in one file because git allows one script per hook.
#
#   1. Stamp `Refs: BE-NNNN` from the branch name, so a commit says which roadmap item it belongs
#      to. Measured before this landed: of the last 100 non-merge commits, 41 named a BE id and 19
#      named any `#N`, and no subject at all carried a `(#NNN)` PR reference — merges carry the PR
#      number, so `git log -L` or `git blame` on a line gives intent-rich prose with nothing to
#      follow to the item or the review that produced it. The branch already encodes the id
#      (`claude/be-0305-<slug>`), so nothing new has to be typed.
#   2. Catch a secret a merge would otherwise pull in silently — at the merge-commit point the
#      index already holds the merged tree, so the same staged-diff scan pre-commit uses applies
#      here too. See .githooks/pre-commit for the enable/bypass notes.
#
# The trailer is skipped for a merge or squash message (generated by git, and about the commits it
# joins rather than this branch) and for a message that is still empty, where `git
# interpret-trailers` would place the trailer on the first line and .githooks/commit-msg would then
# read it as a non-conventional subject and block the commit.
#
# Bypass: `git commit --no-verify` does NOT reach this hook — it skips only pre-commit and
# commit-msg. Delete the trailer in the editor for a one-off, and use
# `git -c core.hooksPath=/dev/null commit` to skip this hook entirely.
set -euo pipefail

msg_file=$1
msg_source=${2-}

roadmap_id() {
	local branch
	branch=$(git symbolic-ref --quiet --short HEAD) || return 1
	# The id must sit on a name boundary: a bare `be` would also match inside "describe-1234".
	[[ $branch =~ (^|[/_-])[Bb][Ee]-?([0-9]{4})([^0-9]|$) ]] || return 1
	printf 'BE-%s\n' "${BASH_REMATCH[2]}"
}

has_subject() {
	grep -qEv '^(#|[[:space:]]*$)' "$1"
}

case "$msg_source" in
merge | squash) ;;
*)
	if id=$(roadmap_id) && has_subject "$msg_file"; then
		git interpret-trailers --in-place --if-exists doNothing \
			--trailer "Refs: $id" "$msg_file"
	fi
	;;
esac

command -v gitleaks >/dev/null 2>&1 || exit 0 # not installed → don't block the commit

exec gitleaks git --pre-commit --staged --redact --no-banner
